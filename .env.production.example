# Required: Neon PostgreSQL connection string
# Get a free database at https://neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://neondb_owner:xxxx@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Required: Secret for Vercel Cron authentication
# Generate one at: https://generate-secret.vercel.app/32
CRON_SECRET="your-secret-here"

# WHOOP API integration (optional)
# Create an app at https://developer.whoop.com/dashboard and copy the credentials.
# Add "<your-app-origin>/api/whoop/callback" as a Redirect URL in the WHOOP app.
WHOOP_CLIENT_ID="your-whoop-client-id"
WHOOP_CLIENT_SECRET="your-whoop-client-secret"
# Optional: pin the OAuth redirect URI. If unset it is derived from the request
# origin as <origin>/api/whoop/callback. Must EXACTLY match the WHOOP dashboard.
WHOOP_REDIRECT_URI="https://your-app.vercel.app/api/whoop/callback"
