generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ScrapeSession {
  id         String        @id @default(cuid())
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     String        @default("running") // running | completed | failed
  error      String?
  rowCount   Int           @default(0)
  records    StockRecord[]

  @@index([startedAt])
  @@index([status])
}

model StockRecord {
  id                 String        @id @default(cuid())
  sessionId          String
  session            ScrapeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scrapedAt          DateTime      @default(now())

  // Company
  symbol             String
  companyName        String

  // 52 Weeks Range
  week52High         Float?
  week52Low          Float?

  // Last Trade
  lastTradePrice     Float?
  lastTradeVolume    Int?
  lastTradeChange    Float?
  lastTradePctChange Float?

  // Cumulative
  numberOfTrades     Int?
  cumulativeVolume   Int?

  // Today's
  todayOpen          Float?
  todayHigh          Float?
  todayLow           Float?

  // Best Bid
  bestBidPrice       Float?
  bestBidQuantity    Int?

  // Best Offer
  bestOfferPrice     Float?
  bestOfferQuantity  Int?

  @@index([sessionId])
  @@index([symbol, scrapedAt])
  @@index([scrapedAt])
}

model CompanyProfile {
  id          String   @id @default(cuid())
  symbol      String   @unique
  companyName String
  sector      String?
  details     Json?
  scrapedAt   DateTime @default(now())

  announcements    Announcement[]
  dividends        Dividend[]
  boardMembers     BoardMember[]
  corporateActions CorporateAction[]

  @@index([sector])
}

model Announcement {
  id        String         @id @default(cuid())
  profileId String
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  date      String?
  category  String?

  @@index([profileId])
}

model Dividend {
  id               String         @id @default(cuid())
  profileId        String
  profile          CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  announcedDate    String?
  eligibilityDate  String?
  distributionDate String?
  distributionWay  String?
  dividendAmount   String?

  @@index([profileId])
}

model BoardMember {
  id           String         @id @default(cuid())
  profileId    String
  profile      CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tradingDate  String?
  shareholder  String?
  designation  String?
  sharesHeld   String?
  sharesPrev   String?
  sharesChange String?

  @@index([profileId])
}

model CorporateAction {
  id        String         @id @default(cuid())
  profileId String
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  date      String?
  details   String?

  @@index([profileId])
}

model FinancialStatement {
  id        String @id @default(cuid())
  symbol    String
  period    String  // "2025-12-31", "2025-09-30", etc.
  type      String  // "annual" or "quarterly"
  data      Json    // { "Total Assets": "2,551,964,000", ... }
  scrapedAt DateTime @default(now())

  @@unique([symbol, period, type])
  @@index([symbol])
}

model HistoricalPrice {
  id        String @id @default(cuid())
  symbol    String
  date      String
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  change    Float?
  changePct Float?
  volume    BigInt?
  value     Float?
  trades    Int?

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}

model InvestmentUpload {
  id         String   @id @default(cuid())
  fileName   String
  uploadedAt DateTime @default(now())

  cash        InvestmentCash[]
  saudiStocks InvestmentSaudiStock[]
  saudiFunds  InvestmentSaudiFund[]
  usaStocks   InvestmentUsaStock[]
  gulfStocks  InvestmentGulfStock[]

  @@index([uploadedAt])
}

model InvestmentCash {
  id          String           @id @default(cuid())
  uploadId    String
  upload      InvestmentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  capitalFirm String
  portfolio   String?
  amount      Float

  @@index([uploadId])
}

model InvestmentSaudiStock {
  id                 String           @id @default(cuid())
  uploadId           String
  upload             InvestmentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  capitalFirm        String
  stockCode          String
  companyName        String?
  qty                Float
  stockCost          Float?
  totalCost          Float?
  brokerMarketPrice  Float?
  brokerCurrentValue Float?

  @@index([uploadId])
  @@index([stockCode])
}

model InvestmentSaudiFund {
  id          String           @id @default(cuid())
  uploadId    String
  upload      InvestmentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  capitalFirm String
  fundName    String
  qty         Float
  costPerUnit Float?
  totalCost   Float?
  closePrice  Float?
  marketValue Float?

  @@index([uploadId])
}

model InvestmentUsaStock {
  id          String           @id @default(cuid())
  uploadId    String
  upload      InvestmentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  ticker      String
  qty         Float
  costValue   Float?
  closePrice  Float?
  marketValue Float?
  profitLoss  Float?

  @@index([uploadId])
}

model InvestmentGulfStock {
  id           String           @id @default(cuid())
  uploadId     String
  upload       InvestmentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  capitalFirm  String?
  market       String
  stockCode    String
  qty          Float
  marketPrice  Float?
  currentValue Float?

  @@index([uploadId])
}

model InvestmentTransaction {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  entityType String   // 'upload' | 'saudi-stock' | 'saudi-fund' | 'usa-stock' | 'gulf-stock' | 'cash'
  entityId   String?
  action     String   // 'upload' | 'update'
  summary    String?
  changes    Json     // { field: { from, to } } for updates, { counts: {...} } for uploads

  @@index([createdAt])
  @@index([entityType, entityId])
}

model DividendUpload {
  id         String   @id @default(cuid())
  fileName   String
  uploadedAt DateTime @default(now())
  rowCount   Int      @default(0)

  dividends  DividendPayment[]

  @@index([uploadedAt])
}

model DividendSymbolMap {
  id        String   @id @default(cuid())
  company   String   @unique
  symbol    String
  updatedAt DateTime @updatedAt

  @@index([symbol])
}

model DividendPayment {
  id              String         @id @default(cuid())
  uploadId        String
  upload          DividendUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  company         String
  symbol          String?
  value           Float
  perShare        Float?
  units           Float?
  distDate        DateTime?
  eligibilityDate DateTime?
  announceDate    DateTime?
  type            String?
  status          String?

  @@index([uploadId])
  @@index([symbol])
  @@index([distDate])
}

// ──────────────────────────────────────────────────────────────────────────
// WHOOP integration
// ──────────────────────────────────────────────────────────────────────────

// OAuth tokens + connection metadata. Single-user app, so a single singleton
// row keyed by a fixed id (WHOOP_CONNECTION_ID = "default" in code).
model WhoopConnection {
  id           String    @id
  whoopUserId  Int?
  email        String?
  firstName    String?
  lastName     String?
  accessToken  String
  refreshToken String?
  scope        String?
  expiresAt    DateTime
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WhoopSyncLog {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  trigger    String    @default("manual") // manual | cron
  status     String    @default("running") // running | completed | failed
  error      String?
  counts     Json? // { recovery, sleep, cycles, workouts }

  @@index([startedAt])
}

// One physiological cycle (a WHOOP "day"). id is an int64 in the WHOOP API.
model WhoopCycle {
  cycleId          BigInt    @id
  start            DateTime
  end              DateTime?
  timezoneOffset   String?
  scoreState       String?
  strain           Float?
  kilojoule        Float?
  averageHeartRate Int?
  maxHeartRate     Int?
  raw              Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([start])
}

// Recovery is keyed by the cycle it belongs to.
model WhoopRecovery {
  cycleId          BigInt   @id
  sleepId          String?
  scoreState       String?
  userCalibrating  Boolean?
  recoveryScore    Float?
  restingHeartRate Float?
  hrvRmssdMilli    Float?
  spo2Percentage   Float?
  skinTempCelsius  Float?
  whoopCreatedAt   DateTime?
  raw              Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([whoopCreatedAt])
}

// Sleep activities. id is a UUID in the WHOOP v2 API.
model WhoopSleep {
  id                       String   @id
  cycleId                  BigInt?
  start                    DateTime
  end                      DateTime
  timezoneOffset           String?
  nap                      Boolean  @default(false)
  scoreState               String?
  sleepPerformancePct      Float?
  sleepConsistencyPct      Float?
  sleepEfficiencyPct       Float?
  respiratoryRate          Float?
  totalInBedTimeMilli      BigInt?
  totalAwakeTimeMilli      BigInt?
  totalLightSleepTimeMilli BigInt?
  totalSwSleepTimeMilli    BigInt?
  totalRemSleepTimeMilli   BigInt?
  sleepCycleCount          Int?
  disturbanceCount         Int?
  raw                      Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([start])
}

// Workout activities. id is a UUID in the WHOOP v2 API.
model WhoopWorkout {
  id               String   @id
  start            DateTime
  end              DateTime
  timezoneOffset   String?
  sportName        String?
  sportId          Int?
  scoreState       String?
  strain           Float?
  averageHeartRate Int?
  maxHeartRate     Int?
  kilojoule        Float?
  percentRecorded  Float?
  distanceMeter    Float?
  altitudeGainMeter Float?
  zoneDurations    Json?
  raw              Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([start])
}
