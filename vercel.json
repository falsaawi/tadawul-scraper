{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "7,12,17,22,27,32,37,42,47,52,57 7-12 * * 0-4"
    },
    {
      "path": "/api/cron/historical",
      "schedule": "0 13 * * 0-4"
    },
    {
      "path": "/api/cron/whoop",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/scrape/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/scrape/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/historical/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/whoop/route.ts": {
      "maxDuration": 120
    }
  }
}
