{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tadawul-scraper",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // --- Scheduled scrape (replaces vercel.json crons) ---
  // Cloudflare cron runs in UTC. Market watch every 5 min during Riyadh
  // trading hours (Sun-Thu ~10:00-15:00 = 07:00-12:00 UTC), plus the daily
  // historical backfill. The Worker's scheduled() handler dispatches to the
  // cron API routes (still guarded by CRON_SECRET).
  "triggers": {
    "crons": [
      "7,12,17,22,27,32,37,42,47,52,57 7-12 * * 0-4",
      "0 13 * * 0-4"
    ]
  },

  // Browser Rendering — used by the scraper (src/lib/browser.ts).
  "browser": { "binding": "BROWSER" },

  // D1 database. database_id is filled in after `wrangler d1 create tadawul`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tadawul",
      "database_id": "363f93fe-de74-4ac2-b7e0-8d033ec8c617",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets are set with `wrangler secret put <NAME>` (not in this file):
  //   ADMIN_USERNAME, ADMIN_PASSWORD, AUTH_SECRET, CRON_SECRET
}
